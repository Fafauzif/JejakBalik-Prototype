# Server-only. Add these two values in Vercel > Project > Settings > Environment Variables.
# Never prefix either secret with VITE_. Never commit your real values.
OPENROUTER_API_KEY=
# Presenter code: random 24+ characters. This is NOT your OpenRouter API key.
AI_DEMO_ACCESS_CODE=
# Optional allowlisted model. Default: google/gemini-2.5-flash-lite
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite
