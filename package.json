{
  "name": "jejak-balik",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json",
    "format:check": "prettier --check src tests *.ts *.json",
    "check:bundle": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "i18next": "26.4.7",
    "lucide-react": "1.58.0",
    "motion": "14.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.19",
    "react-router-dom": "7.18.4",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
